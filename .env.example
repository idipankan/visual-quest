# Copy this file to ".env" (which is git-ignored) and fill in your key.
# Never commit .env or put the key in a VITE_* variable (those are bundled into the browser code).

# Required: your TypeSafe API key
TYPESAFE_API_KEY=

# Optional
# PORT=8787
# JEV_RATE_LIMIT_PER_MINUTE=20
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
